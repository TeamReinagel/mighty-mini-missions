{
  "display_information": {
    "name": "Joyce",
    "description": "Weekly learning reports, daily activity ideas, and the everyday wins you tell her about. Learns with your approval.",
    "background_color": "#5b3f8c"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Joyce",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "channels:history", "groups:history", "im:history", "incoming-webhook"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR-SITE.netlify.app/api/joyce",
      "bot_events": ["message.channels", "message.groups", "message.im"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://YOUR-SITE.netlify.app/api/joyce"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
