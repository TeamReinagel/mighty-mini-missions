<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:keepScreenOn="true"
    android:orientation="vertical">

    <family.reinagel.joyce.MarkView
        android:id="@+id/mark"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111111" />

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cream"
        android:orientation="vertical"
        android:padding="16dp">

        <ScrollView
            android:id="@+id/conversation"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <FrameLayout
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ear"
                android:layout_width="70dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@string/listening"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ear" />

            <LinearLayout
                android:id="@+id/thinking"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/thinking"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/face"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/thinking"
                    android:scaleType="centerCrop"
                    android:src="@drawable/joyce_avatar" />

                <ImageView
                    android:id="@+id/dot1"
                    android:importantForAccessibility="no"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_dot" />

                <ImageView
                    android:id="@+id/dot2"
                    android:importantForAccessibility="no"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_dot" />

                <ImageView
                    android:id="@+id/dot3"
                    android:importantForAccessibility="no"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_dot" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap the word, or draw around the problem."
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxHeight="180dp"
            android:scrollbars="vertical"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        </LinearLayout>
        </ScrollView>
        <Button
            android:id="@+id/ask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/teal"
            android:contentDescription="@string/ask_joyce"
            android:minHeight="56dp"
            android:text="@string/ask_joyce"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/outcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/gotIt"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@color/teal"
                android:contentDescription="@string/got_it"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_got_it"
                app:tint="@android:color/white"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/replay"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@color/sand"
                android:contentDescription="@string/hear_again"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/ink"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@color/sand"
                android:contentDescription="@string/back_to_app"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/ink" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
