<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:keepScreenOn="true"
    android:orientation="vertical">

    <family.reinagel.joyce.MarkView
        android:id="@+id/mark"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111111" />

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cream"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ear"
                android:layout_width="140dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:contentDescription="@string/listening"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ear" />

            <LinearLayout
                android:id="@+id/thinking"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/thinking"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/face"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:contentDescription="@string/thinking"
                    android:scaleType="centerCrop"
                    android:src="@drawable/joyce_avatar" />

                <ImageView
                    android:id="@+id/dot1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_dot" />

                <ImageView
                    android:id="@+id/dot2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_dot" />

                <ImageView
                    android:id="@+id/dot3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_dot" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap the word, or draw around the problem."
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxHeight="180dp"
            android:scrollbars="vertical"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/ask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/teal"
            android:contentDescription="@string/ask_joyce"
            android:minHeight="76dp"
            android:text="@string/ask_joyce"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/outcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/gotIt"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@color/teal"
                android:contentDescription="@string/got_it"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_got_it"
                android:tint="@android:color/white"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/back"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:background="@color/sand"
                android:contentDescription="@string/back_to_app"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                android:tint="@color/ink" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
